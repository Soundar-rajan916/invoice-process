# -----------------------------------------------------------------------------
# InvoiceFlow Environment Configuration
# -----------------------------------------------------------------------------

# Environment mode: 'development', 'production', 'test'
ENVIRONMENT=development

# Database (PostgreSQL 16)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/invoiceflow
# Synchronous DB URL for Alembic migrations if needed
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/invoiceflow

# Redis Broker for Celery
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO / S3 compatible)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=invoices
S3_REGION=us-east-1

# Authentication & Security
JWT_SECRET=change-this-in-production-to-a-secure-random-secret-key-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=60

# Extractor Engine ('groq' | 'mock')
EXTRACTOR=mock
MOCK_MANIFEST_PATH=data/synthetic/manifest.jsonl

# Groq API Configuration
GROQ_API_KEY=gsk_your_groq_api_key_here
# Note: Model IDs change. Choose currently available models from the Groq console docs and set them here. The vision model must accept image input.
# Examples:
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview
GROQ_MAX_CONCURRENCY=4
GROQ_MAX_IMAGES_PER_REQUEST=5
GROQ_MAX_REQUEST_BYTES=3500000
GROQ_REPAIR_RETRIES=2
GROQ_TIMEOUT_SECONDS=60

# Preprocessing & Quality Thresholds (R1)
MAX_IMAGE_LONG_SIDE=1600
MIN_TEXT_CHARS=80
BLUR_REJECT_THRESHOLD=50.0
MAX_UPLOAD_MB=20

# Business Validation Rules (R2, R3)
BUYER_GSTIN=33AAAAA0000A1Z5
BUYER_STATE_CODE=33
AMOUNT_TOLERANCE=0.01
TOTAL_ROUNDING_TOLERANCE=1.00
LOW_CONFIDENCE_THRESHOLD=0.7

# Accounting API Push Service
ACCOUNTING_API_URL=http://localhost:8001
ACCOUNTING_API_KEY=accounting-secret-token
PUSH_MAX_ATTEMPTS=3

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Initial Seed Admin User
ADMIN_EMAIL=admin@invoiceflow.local
ADMIN_PASSWORD=AdminPassword123!

# -----------------------------------------------------------------------------
# Phase 4 Intake & Notifications Configuration
# -----------------------------------------------------------------------------
EMAIL_INTAKE_ENABLED=false
EMAIL_IMAP_HOST=imap.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_USER=invoices@example.com
EMAIL_IMAP_PASSWORD=secret-app-password
EMAIL_FOLDER=INBOX
EMAIL_PROCESSED_FOLDER=Processed
EMAIL_FAILED_FOLDER=Failed
EMAIL_POLL_INTERVAL_SECONDS=60
EMAIL_MIN_ATTACHMENT_BYTES=5000
EMAIL_MIN_IMAGE_PIXELS=100
EMAIL_MAX_ATTACHMENT_BYTES=20971520
EMAIL_MAX_ATTACHMENTS_PER_MESSAGE=10
EMAIL_MAX_PDF_PAGES=50
EMAIL_ALLOWED_SENDER_DOMAINS=

# -----------------------------------------------------------------------------
# WhatsApp Intake Configuration (OpenWA & Meta Cloud API)
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=openwa                 # openwa | meta
WHATSAPP_GROUP_WINDOW_SECONDS=90
WHATSAPP_MAX_OUTBOUND_PER_HOUR=20
OPENWA_BASE_URL=http://openwa:2785/api
OPENWA_API_KEY=
OPENWA_SESSION_NAME=invoiceflow
OPENWA_SESSION_ID=                       # written by make whatsapp-setup
OPENWA_WEBHOOK_SECRET=
OPENWA_WEBHOOK_TARGET_URL=http://api:8000/api/v1/webhooks/whatsapp/openwa
OPENWA_DASHBOARD_URL=http://localhost:2785
OPENWA_ALLOW_GROUPS=false
OPENWA_ALLOWED_SENDERS=                  # optional comma-separated numbers; empty means any sender
OPENWA_ACCEPT_UNOFFICIAL_RISK=false

# Meta WhatsApp Cloud API (Required when WHATSAPP_PROVIDER=meta)
WHATSAPP_PHONE_NUMBER_ID=100000000000001
WHATSAPP_API_TOKEN=EAAG...
WHATSAPP_APP_SECRET=dev-whatsapp-app-secret
WHATSAPP_VERIFY_TOKEN=invoiceflow-verify-token
WHATSAPP_RESEND_TEMPLATE=invoice_resend_request

EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=invoices@invoiceflow.local
RESEND_MAX_PER_SENDER_PER_DAY=5

# Safety Net & Antivirus (4.5 & 4.6)
SECOND_OPINION_ENABLED=false
GROQ_SECOND_MODEL=llama-3.2-90b-vision-preview
ANTIVIRUS_ENABLED=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# -----------------------------------------------------------------------------
# Phase 5 Resiliency, Fallbacks & Leases
# -----------------------------------------------------------------------------
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=
REVIEW_CLAIM_TIMEOUT_MINUTES=5

# -----------------------------------------------------------------------------
# Phase 6 Security, Observability & Shadow Mode
# -----------------------------------------------------------------------------
RETENTION_DAYS=0
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
SHADOW_MODE=false
